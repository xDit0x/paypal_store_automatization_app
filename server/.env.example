# Servidor
NODE_ENV=development
PORT=3000

# Supabase (service role: solo en el backend, nunca en Flutter)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq
GROQ_API_KEY=gsk_your_groq_key
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b

# PayPal Sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Email transaccional (Resend). EMAIL_FROM debe ser un dominio verificado
# en Resend; con onboarding@resend.dev solo puedes enviar a tu propio email.
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=Restock <onboarding@resend.dev>

# Orígenes permitidos por CORS (separados por comas). En producción es
# obligatorio: los que no estén en la lista no pueden llamar a la API.
ALLOWED_ORIGINS=http://localhost:3000

# Puerto y entorno
LOG_LEVEL=info

# Revisión automática de stock: el agente revisa todas las tiendas a estas horas.
RESTOCK_SCHEDULE=09:00,21:00
RESTOCK_TIMEZONE=Europe/Madrid
RESTOCK_SCHEDULE_ENABLED=true
# Solo estas tiendas (ids separados por comas). Vacío = todas.
RESTOCK_STORE_IDS=

# Sincronización de catálogos por API del proveedor.
# CATAlOG_SYNC_TOKEN protege el endpoint /catalog/sync/:code para que
# solo el proveedor con ese token pueda actualizar precios y productos.
CATALOG_SYNC_TOKEN=your-catalog-sync-token
CATALOG_SYNC_ENABLED=true
# Minutos entre sincronizaciones automáticas (por defecto 6h = 360).
CATALOG_SYNC_INTERVAL_MINUTES=360
