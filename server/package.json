{
  "name": "restock-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check:groq": "tsx src/scripts/check-groq.ts",
    "check:supabase": "tsx src/scripts/check-supabase.ts",
    "check:paypal": "tsx src/scripts/check-paypal.ts",
    "check:agent": "tsx src/scripts/check-agent.ts",
    "demo:user": "tsx src/scripts/create-demo-user.ts",
    "store:paypal": "tsx src/scripts/configure-store.ts",
    "send:invoice": "tsx src/scripts/send-invoice.ts",
    "inspect:stock": "tsx src/scripts/inspect-stock.ts",
    "approve:order": "tsx src/scripts/approve-order.ts",
    "reset:demo": "tsx src/scripts/reset-demo.ts",
    "job:restock": "tsx src/scripts/run-scheduled-restock.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "groq-sdk": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
